# ──────────────────────────────────────────────────────────
# Environment template — copy to `.env` and fill values
# NEVER commit .env (it's already in .gitignore)
# ──────────────────────────────────────────────────────────

# ─── App ────────────────────────────────────────────────
APP_ENV=development                     # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
CACHE_TTL_SECONDS=3600                  # Streamlit data cache (1h default)

# ─── CKAN / Open Data Portal ────────────────────────────
CKAN_BASE_URL=https://catalogodatos.nl.gob.mx
CKAN_TIMEOUT_SECONDS=30
CKAN_USER_AGENT=NL2026-Quality-Analyzer/1.0

# ─── Optional: AI discrepancy detection ─────────────────
# Leave blank to disable AI-assisted analysis
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Cloud Run / Production only ────────────────────────
PORT=8080                               # Cloud Run injects this
GOOGLE_CLOUD_PROJECT=                   # Your GCP/Firebase project ID
GCP_REGION=us-central1

# ─── Firebase (for landing page) ────────────────────────
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_DASHBOARD_URL=              # e.g. https://dashboard-xxx.run.app

# ─── Monitoring / alerts ────────────────────────────────
SENTRY_DSN=                             # leave blank if not using Sentry
ALERT_EMAIL=                            # operations alerts go here
